# Copy this file to .env and fill in the API key(s) for the provider you want to use with `--backend litellm`
# Example:
#   cp .env.example .env
#   rap run --backend litellm --model gemini/gemma-4-26b-a4b-it

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional per-model rate limits (Tokens Per Minute / Requests Per Minute)
# Priority: CLI flags (--tpm/--rpm) > RAP_TPM_<MODEL> > RAP_MODEL_LIMITS > RAP_TPM / RAP_RPM
# RAP_TPM_GEMINI_GEMMA_4_31B_IT=15000
# RAP_RPM_GEMINI_GEMMA_4_31B_IT=30
# RAP_TPM_GEMINI_GEMMA_4_26B_A4B_IT=15000
# RAP_RPM_GEMINI_GEMMA_4_26B_A4B_IT=30

# Or compact JSON map per model:
# RAP_MODEL_LIMITS={"gemini/gemma-4-31b-it":{"tpm":15000,"rpm":30},"openai/gpt-4o-mini":{"tpm":200000,"rpm":500}}

# Global fallback if no per-model limit is set:
# RAP_TPM=30000
# RAP_RPM=60
